{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/main",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmitOnError": true,
    "composite": false
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts"]
}
