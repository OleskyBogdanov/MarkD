{
  "name": "markd",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "main": "dist/main/main/main.js",
  "description": "MarkD — редактор переносимых документов для macOS",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev": "npm run build:main && npm run build:preload && concurrently \"vite --host 127.0.0.1 --port 40173 --strictPort\" \"cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://127.0.0.1:40173 node scripts/run-electron.mjs\"",
    "package:mac": "npm run build && node scripts/package-mac.mjs && npm run smoke:app",
    "package:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 --publish never",
    "smoke:app": "node scripts/smoke-packaged-app.mjs",
    "deps:deprecated": "node scripts/check-deprecated-dependencies.mjs"
  },
  "keywords": [
    "electron",
    "react",
    "kp",
    "editor",
    "pdf"
  ],
  "author": "Codex",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "lucide-react": "1.39.0",
    "nanoid": "6.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "playwright": "1.62.1",
    "sass": "1.103.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.markd.desktop",
    "productName": "MarkD",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "dist-package"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dir",
      "hardenedRuntime": false,
      "identity": "-"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MarkD-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MarkD"
    },
    "fileAssociations": [
      {
        "ext": "markd",
        "name": "Проект MarkD",
        "description": "Переносимый проект MarkD",
        "role": "Editor"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": ""
    },
    "extraMetadata": {
      "main": "dist/main/main/main.js"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
